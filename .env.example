# =========================================================================
# TeleCore Telegram Bot Configuration
# =========================================================================

# Telegram Bot Token obtained from @BotFather
BOT_TOKEN=your_bot_token_from_botfather_here

# Comma-separated Telegram User IDs for Admin privileges
ADMIN_IDS=123456789,987654321

# SQLite Database storage location
DATABASE_PATH=bot_database.sqlite3

# Minimum seconds allowed between user messages (Anti-flood)
RATE_LIMIT_SECONDS=1.0

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
