# =========================================================================
# TeleCore: Production Telegram Bot Framework Configuration
# =========================================================================

# --- 1. Core Telegram Bot Settings ---
# Obtained from Telegram @BotFather
BOT_TOKEN=your_bot_token_from_botfather_here

# Comma-separated list of Telegram User IDs who have Admin permissions
ADMIN_IDS=123456789,987654321

# Anti-flood rate limit (seconds between requests per user)
RATE_LIMIT_SECONDS=1.0

# Drop unhandled updates that accumulated while bot was offline
DROP_PENDING_UPDATES=true

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO


# --- 2. Database Settings ---
# Default SQLite local database file path
SQLITE_PATH=bot_database.sqlite3

# PostgreSQL connection string (Optional: for high concurrency)
DATABASE_URL=sqlite+aiosqlite:///bot_database.sqlite3


# --- 3. Redis Cache / FSM Storage (Optional) ---
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0


# --- 4. Webhook Mode Settings (Optional: for production cloud hosting) ---
WEBHOOK_ENABLED=false
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PATH=/webhook
WEBHOOK_URL=https://your-domain.com/webhook


# --- 5. Pluggable Feature Modules (Enable/Disable as needed) ---
ENABLE_MODULE_ADMIN=true
ENABLE_MODULE_BROADCAST=true
ENABLE_MODULE_FORCE_SUB=false
ENABLE_MODULE_REFERRALS=true
ENABLE_MODULE_AI=false
ENABLE_MODULE_MINIAPP=false
ENABLE_MODULE_PAYMENTS=false
ENABLE_MODULE_ANALYTICS=true


# --- 6. Module Specific Configurations ---
# Required if ENABLE_MODULE_FORCE_SUB=true
FORCE_SUB_CHANNEL=@BipinOne
FORCE_SUB_URL=https://t.me/BipinOne

# Required if ENABLE_MODULE_MINIAPP=true
MINIAPP_URL=https://your-webapp-domain.com

# Required if ENABLE_MODULE_AI=true
OPENAI_API_KEY=your_openai_api_key_here


# --- 7. Telegram Group & Forum Topic Logging ---
# Telegram Group or Channel ID to receive real-time bot alerts (e.g. -1001234567890)
LOG_CHAT_ID=-1001234567890

# Automatically create a dedicated Forum Topic for EACH new user (Supergroups with Topics enabled!)
# If true: automatically runs create_forum_topic "{Name} | {UserID}" and organizes user logs per topic!
AUTO_CREATE_USER_TOPICS=true

# Optional: Default Thread ID for general system/error alerts
# Leave blank for normal groups/channels without static topics.
LOG_THREAD_ID=


# --- 8. Two-Way Topic Live Chat & CRM Support ---
# Relay user private messages to their forum topic, and relay admin replies back to user!
ENABLE_TOPIC_SUPPORT_CHAT=true


# --- 9. Cloud Health Check Server (Uptime & Anti-Sleep for Render/Railway/VPS) ---
# Starts an embedded HTTP server on port 8080 (or $PORT) returning 200 OK on /health
HEALTH_SERVER_ENABLED=true
HEALTH_SERVER_HOST=0.0.0.0
HEALTH_SERVER_PORT=8080
